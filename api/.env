# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> boundary-lab ###
# Which risk engine serves requests by default.
#   php        in-process PHP                     (Experiment 1, always available)
#   go-http    a Go service over HTTP             (Experiment 2, needs the risk-engine service)
#   go-native  a Go function inside this process  (Experiment 3, needs a FrankenPHP build
#                                                  including the Go extension)
RISK_ENGINE=php

# Allows a single request to pick its engine via the X-Boundary-Lab-Engine header.
#
# This is a LAB AFFORDANCE and it defaults to off. It exists so that the three live demos, and
# the parity and benchmark harnesses, can address one running process with one contract and no
# restarts. An endpoint whose behaviour can be steered by a header has no business being
# reachable in production.
BOUNDARY_LAB_ALLOW_ENGINE_OVERRIDE=0

# Where the remote Go engine lives. Only read when RISK_ENGINE=go-http, or when the override
# header selects it.
RISK_ENGINE_URL=http://risk-engine:8081

# Transport policy for the remote engine, in seconds.
#   TIMEOUT       inactivity on an open connection
#   MAX_DURATION  hard ceiling on the whole exchange, so a slow dependency cannot exhaust workers
RISK_ENGINE_TIMEOUT=1.0
RISK_ENGINE_MAX_DURATION=2.0

# Size of the decision-tree ensemble used by the ENSEMBLE profile.
#
# MUST be identical for PHP, the Go service and the Go extension, otherwise they score different
# models and parity is meaningless. The benchmark sweeps this value to find the point where
# computation cost overtakes boundary cost.
BOUNDARY_LAB_TREE_COUNT=256
###< boundary-lab ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

MONGODB_URI="mongodb://mongo:27017/?w=majority&journal=true"
PHP_RISK_ENGINE_URL=http://php-risk
PRIVATE_RISK_SERVICE=0
