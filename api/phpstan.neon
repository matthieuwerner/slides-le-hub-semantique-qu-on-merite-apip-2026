includes:
    - vendor/phpstan/phpstan-symfony/extension.neon

parameters:
    level: 9

    paths:
        - src
        - public/index.php
        - tests

    excludePaths:
        analyseAndScan:
            # Generated by Jane from contract/risk-engine.openapi.yaml.
            #
            # Excluded from *analysis* but still available for type information, which is the
            # arrangement that matters: PHPStan does not grade the generator's output, but it does
            # check every one of our call sites against it. That is what makes "make contract-break"
            # fail in CI rather than in production.
            - src/Infrastructure/Generated
        analyse:
            # The generated FrankenPHP stub. Loaded via scanFiles below for symbol discovery, but
            # not analysed: it declares bare `array` types because that is all the extension API can
            # express, and grading a generator's output achieves nothing.
            - stubs/native-risk.stub.php

    stubFiles:
        # The typed view of the Go extension.
        #
        # This is the detail worth pausing on. The Go compiler's understanding of a function
        # signature is what type-checks a PHP call site: `frankenphp extension-init` generates the
        # PHP declarations *from the Go source*, so the cross-language contract is not a document
        # someone must remember to update — it is a build artifact of one side.
        #
        # This file adds the array shapes the generator cannot express. `make check-stub` proves it
        # still agrees with the generated signatures.
        - stubs/native-risk.phpstan-stub.php

    scanFiles:
        # Makes the extension's symbols known even when the extension is not loaded in the process
        # running PHPStan, which is the normal case on a developer machine.
        - stubs/native-risk.stub.php

    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml

    # Every entry below is a specific, explained exception. There is no baseline: a codebase this
    # size has no excuse for one, and a baseline would hide exactly the drift this project is about.
    ignoreErrors:
        -
            # Called by Symfony itself, from KernelTrait, to validate APP_ENV
            # (vendor/symfony/dependency-injection/Kernel/KernelTrait.php:582). PHPStan cannot see
            # that because it is a private method overriding a private trait method.
            message: '#Method App\\Kernel::getAllowedEnvs\(\) is unused#'
            path: src/Kernel.php

    treatPhpDocTypesAsCertain: false
