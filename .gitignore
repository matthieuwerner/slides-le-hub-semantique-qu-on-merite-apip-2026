# The talk organiser's brief and speaker bio. Working notes, not part of the artifact.
PITCH.md

# ---- PHP -----------------------------------------------------------------------------------------
/api/vendor/
/api/var/
/api/.env.local
/api/.env.*.local
/api/.phpunit.cache/
/api/phpunit.xml
/api/public/bundles/

# ---- Go ------------------------------------------------------------------------------------------
# The compiled FrankenPHP binary. ~67 MB, and reproducible with `make build`.
/build/frankenphp/frankenphp

# Generated by `frankenphp extension-init` from go/ext/risk.go.
#
# The C glue is regenerated on every build, so it is not committed. The PHP stub IS committed, at
# api/stubs/native-risk.stub.php, because PHPStan needs it and because it is the cross-language
# contract — a reviewer should be able to read it without running a Docker build.
/go/ext/risk.c
/go/ext/risk.h
/go/ext/risk_arginfo.h
/go/ext/risk_generated.go

